#!/usr/bin/env bash
# ==============================================================================
# GoodWifi Git Pre-commit Hook (Lint-Staged Architecture)
# Runs comprehensive checks on STAGED files before every commit to guarantee CI passes.
# ==============================================================================
set -eo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$REPO_ROOT"

# Color helpers
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# 1. Retrieve Staged Files (Added, Copied, Modified)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

echo -e "${CYAN}🔍 [Pre-commit] Checking staged changes before commit...${NC}"
FAILURES=0

# Filter staged files by category
STAGED_PY=()
STAGED_SH=()
for f in $STAGED_FILES; do
    if [ ! -f "$f" ]; then
        continue
    fi
    # Ignore virtualenvs
    if [[ "$f" =~ (\.venv|venv)/ ]]; then
        continue
    fi

    # Python files
    if [[ "$f" =~ \.py$ ]]; then
        STAGED_PY+=("$f")
        continue
    fi

    # Shell scripts (.sh or files in configs/scripts with shell shebang)
    if [[ "$f" =~ \.sh$ ]]; then
        STAGED_SH+=("$f")
        continue
    fi
    if [[ "$f" =~ ^(configs|scripts)/ ]]; then
        head_line=$(head -n 1 "$f" 2>/dev/null || true)
        if [[ "$head_line" =~ ^#!.*(sh|bash) ]]; then
            STAGED_SH+=("$f")
        fi
    fi
done

# ------------------------------------------------------------------------------
# 2. Architecture & Hygiene Checks
# ------------------------------------------------------------------------------
# Rule 1: Never duplicate hotspot-manager.py into telegrambot/
if [ -f "telegrambot/hotspot-manager.py" ]; then
    echo -e "${RED}❌ [Architecture Error]: Duplicate hotspot-manager.py found in telegrambot/!${NC}"
    echo -e "   The bot container must execute the host script via nsenter."
    FAILURES=$((FAILURES + 1))
fi

# Sensitive files leak check
for f in $STAGED_FILES; do
    if [[ "$f" =~ (^|/)(\.env|\.env\..*)$ ]]; then
        echo -e "${RED}❌ [Security Error]: Staged sensitive environment file: $f${NC}"
        FAILURES=$((FAILURES + 1))
    fi
done

# ------------------------------------------------------------------------------
# 3. Staged Python Quality Checks
# ------------------------------------------------------------------------------
if [ "${#STAGED_PY[@]}" -gt 0 ]; then
    echo -e "\n${YELLOW}🐍 Inspecting ${#STAGED_PY[@]} staged Python file(s)...${NC}"

    # A. Python Syntax Compilation
    for pyfile in "${STAGED_PY[@]}"; do
        if ! python3 -m py_compile "$pyfile" 2>/dev/null; then
            echo -e "${RED}❌ Syntax error in: $pyfile${NC}"
            FAILURES=$((FAILURES + 1))
        fi
    done

    # B. Sweet Spot File Length (<300 lines - Rule 2)
    for pyfile in "${STAGED_PY[@]}"; do
        line_count=$(wc -l < "$pyfile")
        if [ "$line_count" -gt 300 ]; then
            echo -e "${RED}❌ File size error: $pyfile has $line_count lines!${NC}"
            echo -e "   Repository Rule 2 strictly enforces files to remain under 300 lines."
            FAILURES=$((FAILURES + 1))
        fi
    done

    # C. Root Test Runner Purity (<40 lines, zero embedded TestCases - Rule 6)
    for runner in "${STAGED_PY[@]}"; do
        if [[ "$runner" =~ tests/test_(telegram_bot|hotspot_manager)\.py ]]; then
            lines=$(wc -l < "$runner")
            if [ "$lines" -gt 40 ]; then
                echo -e "${RED}❌ Test Runner error: $runner has $lines lines (max 40).${NC}"
                FAILURES=$((FAILURES + 1))
            fi
            if grep -q -E 'class [A-Za-z0-9_]+\(.*TestCase.*\):' "$runner"; then
                echo -e "${RED}❌ $runner defines a TestCase directly! New tests belong in tests/bot/ or tests/hotspot/.${NC}"
                FAILURES=$((FAILURES + 1))
            fi
        fi
    done

    # D. Black Code Formatting Check
    if command -v black >/dev/null 2>&1; then
        if ! black --check "${STAGED_PY[@]}" 2>/dev/null; then
            echo -e "${RED}❌ Black formatting check failed on staged files!${NC}"
            echo -e "${YELLOW}👉 Run: black ${STAGED_PY[*]}${NC}"
            FAILURES=$((FAILURES + 1))
        fi
    fi

    # E. Flake8 Linting Check
    if command -v flake8 >/dev/null 2>&1; then
        if ! flake8 --max-line-length=88 --extend-ignore=E203,W503 "${STAGED_PY[@]}"; then
            echo -e "${RED}❌ Flake8 linting check failed on staged files!${NC}"
            FAILURES=$((FAILURES + 1))
        fi
    fi
fi

# ------------------------------------------------------------------------------
# 4. Staged Shell Scripts Quality Checks (ShellCheck)
# ------------------------------------------------------------------------------
if [ "${#STAGED_SH[@]}" -gt 0 ]; then
    echo -e "\n${YELLOW}🐚 Inspecting ${#STAGED_SH[@]} staged Shell script(s)...${NC}"
    if command -v shellcheck >/dev/null 2>&1; then
        if ! shellcheck "${STAGED_SH[@]}"; then
            echo -e "${RED}❌ ShellCheck found issues in staged shell scripts!${NC}"
            FAILURES=$((FAILURES + 1))
        fi
    else
        echo -e "${YELLOW}⚠️  shellcheck not installed locally; skipping shell lint.${NC}"
    fi
fi

# ------------------------------------------------------------------------------
# 5. Targeted Unit Tests (Runs when code is modified)
# ------------------------------------------------------------------------------
if [ "${#STAGED_PY[@]}" -gt 0 ] || [ "${#STAGED_SH[@]}" -gt 0 ]; then
    echo -e "\n${YELLOW}🧪 Running targeted unit tests...${NC}"
    if ! env PYTHONHOME="" PYTHONPATH="$REPO_ROOT" python3 -m unittest discover -s tests/hotspot -p "test_*.py" >/dev/null 2>&1; then
        echo -e "${RED}❌ Hotspot Manager unit tests failed!${NC}"
        echo -e "   Run 'python3 -m unittest -v tests/test_hotspot_manager.py' for details."
        FAILURES=$((FAILURES + 1))
    fi

    BOT_PYTHONPATH="${REPO_ROOT}/telegrambot/.venv/lib/python3.11/site-packages:${REPO_ROOT}"
    if ! env PYTHONHOME="" PYTHONPATH="$BOT_PYTHONPATH" python3 -m unittest discover -s tests/bot -p "test_*.py" >/dev/null 2>&1; then
        echo -e "${RED}❌ Telegram Bot unit tests failed!${NC}"
        echo -e "   Run 'python3 -m unittest -v tests/test_telegram_bot.py' for details."
        FAILURES=$((FAILURES + 1))
    fi
fi

# ------------------------------------------------------------------------------
# 6. Final Evaluation
# ------------------------------------------------------------------------------
if [ "$FAILURES" -gt 0 ]; then
    echo -e "\n${RED}💥 [Pre-commit Aborted] $FAILURES check(s) failed.${NC}"
    echo -e "${RED}Please resolve the errors above before committing.${NC}\n"
    exit 1
fi

echo -e "\n${GREEN}✅ [Pre-commit Passed] All checks passed! Proceeding with commit.${NC}\n"
exit 0
