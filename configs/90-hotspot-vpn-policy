#!/bin/sh
# Keep Pi host traffic on eth0 while routing hotspot clients through the VPN.

# Load optional config override if present
# shellcheck source=/dev/null
[ -f /etc/goodwifi/goodwifi.conf ] && . /etc/goodwifi/goodwifi.conf
VPN_BACKEND="${VPN_BACKEND:-auto}"

HOTSPOT_IF="${HOTSPOT_IF:-wlan0}"
HOTSPOT_SUBNET="${HOTSPOT_SUBNET:-10.42.0.0/24}"
HOTSPOT_IP="${HOTSPOT_IP:-10.42.0.1}"
LAN_IF_CONFIGURED="${LAN_IF:-}"

# Secondary Router Access Point (TP-Link via eth1)
ROUTER_AP_IF="${ROUTER_AP_IF:-eth1}"
ROUTER_AP_SUBNET="${ROUTER_AP_SUBNET:-10.43.0.0/24}"
ROUTER_AP_IP="${ROUTER_AP_IP:-10.43.0.1}"
ROUTER_AP_ROUTER_IP="${ROUTER_AP_ROUTER_IP:-10.43.0.2}"
ROUTER_AP_ALIAS_IP="${ROUTER_AP_ALIAS_IP:-192.168.100.2}"

detect_active_wan_if() {
    # 0. Check dynamic WAN state file if active
    if [ -f "/run/goodwifi-active-wan" ]; then
        active_wan="$(tr -d ' \n\r' < /run/goodwifi-active-wan 2>/dev/null)"
        if [ -n "$active_wan" ]; then
            printf '%s\n' "$active_wan"
            return
        fi
    fi

    if [ -n "$LAN_IF_CONFIGURED" ] && [ "$LAN_IF_CONFIGURED" != "auto" ]; then
        printf '%s\n' "$LAN_IF_CONFIGURED"
        return
    fi

    # 1. Check default route device in table main
    cand_wan="$(ip -4 route show default table main 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dev") print $(i+1); exit}')"
    if [ -n "$cand_wan" ] && [ "$cand_wan" != "${HOTSPOT_IF:-wlan0}" ] && [ "$cand_wan" != "${ROUTER_AP_IF:-eth1}" ] && [ "$cand_wan" != "${VPN_IF:-}" ]; then
        printf '%s\n' "$cand_wan"
        return
    fi

    # 2. Check active carrier on eth0, then usb0, etc. (never AP interfaces)
    for iface in eth0 usb0 usb1; do
        if [ "$iface" = "$HOTSPOT_IF" ] || [ "$iface" = "$ROUTER_AP_IF" ]; then
            continue
        fi
        if ip link show "$iface" 2>/dev/null | grep -q "state UP" && ip -4 addr show "$iface" 2>/dev/null | grep -q "inet "; then
            printf '%s\n' "$iface"
            return
        fi
    done

    printf '%s\n' "eth0"
}

LAN_GW_OVERRIDE="${LAN_GW:-}"
TABLE_ID="${TABLE_ID:-100}"
RULE_PRIORITY="${RULE_PRIORITY:-1000}"
HOST_RULE_PRIORITY="${HOST_RULE_PRIORITY:-999}"
BYPASS_RULE_PRIORITY="${BYPASS_RULE_PRIORITY:-998}"
MANAGEMENT_RULE_PRIORITY="${MANAGEMENT_RULE_PRIORITY:-997}"
FWMARK="${FWMARK:-100}"
BYPASS_FWMARK="${BYPASS_FWMARK:-101}"
VPN_IPSET="${VPN_IPSET:-vpn_domains}"
VPN_ROUTES_IPSET="${VPN_ROUTES_IPSET:-vpn_routes}"
LOCAL_ROUTES_IPSET="${LOCAL_ROUTES_IPSET:-local_routes}"
LEGACY_GITHUB_IPSET="github_vpn_routes"
LEGACY_LOCAL_IPSET="local_bypass_domains"
IPTABLES_CHAIN="${IPTABLES_CHAIN:-GOODWIFI_FORWARD}"
IP6TABLES_CHAIN="${IP6TABLES_CHAIN:-GOODWIFI6_FORWARD}"
MANAGEMENT_SUBNETS="${MANAGEMENT_SUBNETS:-10.8.0.0/24 192.168.100.0/24 192.168.1.0/24}"
IPV6_LEAK_PROTECTION="${IPV6_LEAK_PROTECTION:-reject}"

detect_wan_subnet() {
    dev="$1"
    ip -4 -o addr show dev "$dev" 2>/dev/null | awk '
        /inet / {
            split($4, a, "/")
            ip_addr = a[1]
            prefix = a[2]
            split(ip_addr, octets, ".")
            if (prefix == "24") {
                print octets[1] "." octets[2] "." octets[3] ".0/24"
                exit
            } else if (prefix != "") {
                print octets[1] "." octets[2] "." octets[3] ".0/" prefix
                exit
            }
        }
    '
}

is_vpn_action() {
    case "$1" in
        apply|cleanup|up|down|vpn-up|vpn-down|connectivity-change) return 0 ;;
        *) return 1 ;;
    esac
}

is_vpn_iface() {
    case "$1" in
        awg*|wg*|tun*|tap*|sing*) return 0 ;;
        *)
            if [ -n "${VPN_BACKEND:-}" ] && [ "$VPN_BACKEND" != "auto" ] && [ "$1" = "$VPN_BACKEND" ]; then
                return 0
            fi
            return 1
            ;;
    esac
}

ACTION=""
if [ -n "${1:-}" ]; then
    if is_vpn_action "$1"; then
        ACTION="$1"
    elif is_vpn_iface "$1"; then
        VPN_IF="$1"
        ACTION="${2:-apply}"
    else
        # NetworkManager dispatcher calls all scripts for every network device event
        # (e.g. eth0, wlan0, docker0, veth*). Events for non-VPN devices must be ignored.
        exit 0
    fi
else
    ACTION="${2:-apply}"
fi

LAN_IF="$(detect_active_wan_if)"

if [ -z "${VPN_IF:-}" ]; then
    if [ "$VPN_BACKEND" = "sing0" ]; then
        VPN_IF="sing0"
    elif [ "$VPN_BACKEND" = "awg0" ]; then
        VPN_IF="awg0"
    elif [ "$VPN_BACKEND" = "wg0" ]; then
        VPN_IF="wg0"
    elif [ "$VPN_BACKEND" = "tun0" ]; then
        VPN_IF="tun0"
    else
        # auto mode: prioritize active interfaces with an IPv4 address
        if ip -4 addr show sing0 2>/dev/null | grep -q "inet "; then
            VPN_IF="sing0"
        elif ip -4 addr show awg0 2>/dev/null | grep -q "inet "; then
            VPN_IF="awg0"
        elif ip -4 addr show wg0 2>/dev/null | grep -q "inet "; then
            VPN_IF="wg0"
        elif ip -4 addr show tun0 2>/dev/null | grep -q "inet "; then
            VPN_IF="tun0"
        elif ip link show sing0 >/dev/null 2>&1; then
            VPN_IF="sing0"
        elif ip link show awg0 >/dev/null 2>&1; then
            VPN_IF="awg0"
        elif ip link show wg0 >/dev/null 2>&1; then
            VPN_IF="wg0"
        else
            VPN_IF="tun0"
        fi
    fi
fi

if [ -z "${VPN_MTU:-}" ]; then
    if [ "$VPN_IF" = "awg0" ] || [ "$VPN_IF" = "wg0" ]; then
        VPN_MTU="1280"
    elif [ "$VPN_IF" = "sing0" ]; then
        VPN_MTU="1380"
    else
        VPN_MTU="${VPN_MTU:-1400}"
    fi
fi

mkdir -p /run/lock
exec 9>/run/lock/goodwifi-vpn-policy.lock
if ! flock -w 60 9; then
    echo "Timed out waiting for the GoodWifi VPN policy lock" >&2
    exit 1
fi

remove_rule() {
    table="$1"
    shift

    if [ "$table" = "filter" ]; then
        while iptables -C "$@" 2>/dev/null; do
            iptables -D "$@"
        done
    else
        while iptables -t "$table" -C "$@" 2>/dev/null; do
            iptables -t "$table" -D "$@"
        done
    fi
}

remove_ip6_rule() {
    while ip6tables -C "$@" 2>/dev/null; do
        ip6tables -D "$@"
    done
}

ensure_filter_chain() {
    chain="$1"
    iptables -N "$chain" 2>/dev/null || true
    iptables -F "$chain"
    iptables -C FORWARD -j "$chain" 2>/dev/null || iptables -I FORWARD 1 -j "$chain"
}

remove_filter_chain() {
    chain="$1"
    remove_rule filter FORWARD -j "$chain"
    iptables -F "$chain" 2>/dev/null || true
    iptables -X "$chain" 2>/dev/null || true
}

ensure_ip6_filter_chain() {
    chain="$1"
    ip6tables -N "$chain" 2>/dev/null || true
    ip6tables -F "$chain"
    ip6tables -C FORWARD -j "$chain" 2>/dev/null || ip6tables -I FORWARD 1 -j "$chain"
}

remove_ip6_filter_chain() {
    chain="$1"
    remove_ip6_rule FORWARD -j "$chain"
    ip6tables -F "$chain" 2>/dev/null || true
    ip6tables -X "$chain" 2>/dev/null || true
}

remove_ap_rules() {
    _if="$1"
    _subnet="$2"
    _ip="$3"
    [ -z "$_if" ] || [ -z "$_subnet" ] && return 0

    remove_rule nat POSTROUTING -s "$_subnet" -o "$VPN_IF" -j MASQUERADE
    remove_rule nat POSTROUTING -o "$_if" -j MASQUERADE
    for wan in "$LAN_IF" eth0 usb0 eth1 usb1; do
        [ "$wan" = "$_if" ] && continue
        remove_rule nat POSTROUTING -s "$_subnet" -m set --match-set "$LOCAL_ROUTES_IPSET" dst -o "$wan" -j MASQUERADE
        remove_rule nat POSTROUTING -s "$_subnet" -m set --match-set "$LEGACY_LOCAL_IPSET" dst -o "$wan" -j MASQUERADE
        remove_rule filter FORWARD -i "$_if" -o "$wan" -j ACCEPT
        remove_rule filter FORWARD -i "$wan" -o "$_if" -m state --state RELATED,ESTABLISHED -j ACCEPT
        remove_rule "$IPTABLES_CHAIN" -i "$_if" -o "$wan" -s "$_subnet" -m set --match-set "$LOCAL_ROUTES_IPSET" dst -j ACCEPT
        remove_rule "$IPTABLES_CHAIN" -i "$wan" -o "$_if" -d "$_subnet" -m state --state RELATED,ESTABLISHED -j ACCEPT
        for subnet in $MANAGEMENT_SUBNETS; do
            remove_rule filter FORWARD -i "$_if" -o "$wan" -s "$_subnet" -d "$subnet" -j ACCEPT
            remove_rule filter FORWARD -i "$wan" -o "$_if" -d "$_subnet" -s "$subnet" -m state --state RELATED,ESTABLISHED -j ACCEPT
            remove_rule "$IPTABLES_CHAIN" -i "$_if" -o "$wan" -s "$_subnet" -d "$subnet" -j ACCEPT
            remove_rule "$IPTABLES_CHAIN" -i "$wan" -o "$_if" -s "$subnet" -d "$_subnet" -j ACCEPT
            remove_rule "$IPTABLES_CHAIN" -i "$wan" -o "$_if" -d "$_subnet" -s "$subnet" -m state --state RELATED,ESTABLISHED -j ACCEPT
            remove_rule nat POSTROUTING -s "$_subnet" -d "$subnet" -o "$wan" -j MASQUERADE
            remove_rule nat POSTROUTING -s "$subnet" -d "$_subnet" -o "$_if" -j MASQUERADE
        done
    done
    if [ "$_if" = "$ROUTER_AP_IF" ] && [ -n "$ROUTER_AP_ALIAS_IP" ]; then
        remove_rule filter INPUT -p tcp --dport 8092 -j ACCEPT
        remove_rule nat PREROUTING -d "$ROUTER_AP_ALIAS_IP" -p tcp --dport 80 -j REDIRECT --to-ports 8092
        remove_rule nat OUTPUT -d "$ROUTER_AP_ALIAS_IP" -p tcp --dport 80 -j REDIRECT --to-ports 8092
        remove_rule nat PREROUTING -d "$ROUTER_AP_ALIAS_IP" ! -p tcp -j DNAT --to-destination "$ROUTER_AP_ROUTER_IP"
        remove_rule nat PREROUTING -d "$ROUTER_AP_ALIAS_IP" -j DNAT --to-destination "$ROUTER_AP_ROUTER_IP"
        remove_rule "$IPTABLES_CHAIN" -d "$ROUTER_AP_ROUTER_IP" -j ACCEPT
        ip -4 addr del "$ROUTER_AP_ALIAS_IP/24" dev eth0 label eth0:router 2>/dev/null || true
    fi
    remove_rule mangle PREROUTING -s "$_subnet" -m set --match-set "$LOCAL_ROUTES_IPSET" dst -j MARK --set-mark "$BYPASS_FWMARK"
    remove_rule mangle PREROUTING -s "$_subnet" -m set --match-set "$LOCAL_ROUTES_IPSET" dst -j MARK --set-mark 0
    remove_rule mangle PREROUTING -s "$_subnet" -m set --match-set "$LEGACY_LOCAL_IPSET" dst -j MARK --set-mark "$BYPASS_FWMARK"
    remove_rule mangle PREROUTING -s "$_subnet" -m set --match-set "$LEGACY_LOCAL_IPSET" dst -j MARK --set-mark 0
    remove_rule mangle FORWARD -s "$_subnet" -o "$VPN_IF" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --set-mss 1200
    remove_rule mangle FORWARD -s "$_subnet" -o "$VPN_IF" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
    remove_rule mangle FORWARD -i "$VPN_IF" -d "$_subnet" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
    remove_rule filter FORWARD -i "$_if" -o "$VPN_IF" -s "$_subnet" -j ACCEPT
    remove_rule filter FORWARD -i "$VPN_IF" -o "$_if" -d "$_subnet" -m state --state RELATED,ESTABLISHED -j ACCEPT
    remove_ip6_rule FORWARD -i "$_if" -j DROP
    remove_ip6_rule FORWARD -i "$_if" -j REJECT --reject-with icmp6-adm-prohibited

    if [ -n "$_ip" ]; then
        remove_rule nat PREROUTING -i "$_if" -p udp --dport 53 ! -d "$_ip" -j DNAT --to-destination "$_ip:53"
        remove_rule nat PREROUTING -i "$_if" -p tcp --dport 53 ! -d "$_ip" -j DNAT --to-destination "$_ip:53"
    fi

    for doh_ip in 8.8.8.8 8.8.4.4 1.1.1.1 1.0.0.1 9.9.9.9 149.112.112.112 208.67.222.222 208.67.220.220 94.140.14.14 94.140.15.15 76.76.2.0 76.76.10.0; do
        remove_rule filter "$IPTABLES_CHAIN" -i "$_if" -d "$doh_ip" -p tcp --dport 443 -j REJECT
        remove_rule filter "$IPTABLES_CHAIN" -i "$_if" -d "$doh_ip" -p udp --dport 443 -j REJECT
    done

    remove_ip6_rule INPUT -i "$_if" -p udp --dport 53 -j REJECT
    remove_ip6_rule INPUT -i "$_if" -p tcp --dport 53 -j REJECT
    remove_rule filter INPUT -i "$_if" -p udp --dport 67:68 -j ACCEPT
    remove_rule filter INPUT -i "$_if" -p tcp --dport 53 -j ACCEPT
    remove_rule filter INPUT -i "$_if" -p udp --dport 53 -j ACCEPT
    remove_rule filter INPUT -i "$_if" -p tcp --dport 22 -j ACCEPT
    remove_rule filter INPUT -i "$_if" -p udp --dport 5353 -j ACCEPT
    remove_rule filter INPUT -i "$_if" -p icmp -j ACCEPT
    remove_rule filter INPUT -i "$_if" -s "$_subnet" -j REJECT --reject-with icmp-port-unreachable
    remove_rule filter INPUT -i "$_if" -m state --state RELATED,ESTABLISHED -j ACCEPT

    ip rule del from "$_subnet" table "$TABLE_ID" priority "$RULE_PRIORITY" 2>/dev/null || true
    for subnet in $MANAGEMENT_SUBNETS; do
        ip rule del from "$_subnet" to "$subnet" table main priority "$MANAGEMENT_RULE_PRIORITY" 2>/dev/null || true
    done
    ip rule del from "$_subnet" to "$_subnet" table main priority "$MANAGEMENT_RULE_PRIORITY" 2>/dev/null || true
}

apply_ap_rules() {
    _if="$1"
    _subnet="$2"
    _ip="$3"
    [ -z "$_if" ] || [ -z "$_subnet" ] && return 0

    ip route replace "$_subnet" dev "$_if" table "$TABLE_ID" 2>/dev/null || true
    ip rule del from "$_subnet" table "$TABLE_ID" priority "$RULE_PRIORITY" 2>/dev/null || true
    ip rule add from "$_subnet" table "$TABLE_ID" priority "$RULE_PRIORITY" 2>/dev/null || true

    for subnet in $MANAGEMENT_SUBNETS; do
        ip rule del from "$_subnet" to "$subnet" table main priority "$MANAGEMENT_RULE_PRIORITY" 2>/dev/null || true
        ip rule add from "$_subnet" to "$subnet" table main priority "$MANAGEMENT_RULE_PRIORITY" 2>/dev/null || true
    done

    # Intra-subnet bypass: traffic within the same AP subnet routes via main table (local interface)
    ip rule del from "$_subnet" to "$_subnet" table main priority "$MANAGEMENT_RULE_PRIORITY" 2>/dev/null || true
    ip rule add from "$_subnet" to "$_subnet" table main priority "$MANAGEMENT_RULE_PRIORITY" 2>/dev/null || true

    iptables -t nat -C POSTROUTING -s "$_subnet" -o "$VPN_IF" -j MASQUERADE 2>/dev/null || \
        iptables -t nat -A POSTROUTING -s "$_subnet" -o "$VPN_IF" -j MASQUERADE
    for subnet in $MANAGEMENT_SUBNETS; do
        target_dev="$(ip route get "${subnet%/*}" 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dev") print $(i+1); exit}')"
        if [ "$target_dev" = "$VPN_IF" ] || [ "$subnet" = "10.8.0.0/24" ]; then
            continue
        fi
        target_dev="${target_dev:-$LAN_IF}"
        iptables -t nat -C POSTROUTING -s "$_subnet" -d "$subnet" -o "$target_dev" -j MASQUERADE 2>/dev/null || \
            iptables -t nat -A POSTROUTING -s "$_subnet" -d "$subnet" -o "$target_dev" -j MASQUERADE
        iptables -t nat -C POSTROUTING -s "$subnet" -d "$_subnet" -o "$_if" -j MASQUERADE 2>/dev/null || \
            iptables -t nat -A POSTROUTING -s "$subnet" -d "$_subnet" -o "$_if" -j MASQUERADE
    done
    iptables -t nat -C POSTROUTING -s "$_subnet" -m set --match-set "$LOCAL_ROUTES_IPSET" dst -o "$LAN_IF" -j MASQUERADE 2>/dev/null || \
        iptables -t nat -A POSTROUTING -s "$_subnet" -m set --match-set "$LOCAL_ROUTES_IPSET" dst -o "$LAN_IF" -j MASQUERADE
    iptables -t nat -C POSTROUTING -o "$_if" -j MASQUERADE 2>/dev/null || \
        iptables -t nat -A POSTROUTING -o "$_if" -j MASQUERADE

    iptables -t mangle -C PREROUTING -s "$_subnet" -m set --match-set "$LOCAL_ROUTES_IPSET" dst -j MARK --set-mark "$BYPASS_FWMARK" 2>/dev/null || \
        iptables -t mangle -I PREROUTING 1 -s "$_subnet" -m set --match-set "$LOCAL_ROUTES_IPSET" dst -j MARK --set-mark "$BYPASS_FWMARK"

    # Hairpin traffic on AP interface (e.g. eth1 -> eth1 for router admin 10.43.0.2)
    iptables -A "$IPTABLES_CHAIN" -i "$_if" -o "$_if" -s "$_subnet" -d "$_subnet" -j ACCEPT

    iptables -A "$IPTABLES_CHAIN" -i "$_if" -o "$LAN_IF" -s "$_subnet" -m set --match-set "$LOCAL_ROUTES_IPSET" dst -j ACCEPT
    iptables -A "$IPTABLES_CHAIN" -i "$LAN_IF" -o "$_if" -d "$_subnet" -m state --state RELATED,ESTABLISHED -j ACCEPT
    for subnet in $MANAGEMENT_SUBNETS; do
        target_dev="$(ip route get "${subnet%/*}" 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dev") print $(i+1); exit}')"
        if [ "$target_dev" = "$VPN_IF" ] || [ "$subnet" = "10.8.0.0/24" ]; then
            continue
        fi
        target_dev="${target_dev:-$LAN_IF}"
        iptables -A "$IPTABLES_CHAIN" -i "$_if" -o "$target_dev" -s "$_subnet" -d "$subnet" -j ACCEPT
        iptables -A "$IPTABLES_CHAIN" -i "$target_dev" -o "$_if" -s "$subnet" -d "$_subnet" -j ACCEPT
    done
    iptables -A "$IPTABLES_CHAIN" -i "$_if" -o "$VPN_IF" -s "$_subnet" -j ACCEPT
    iptables -A "$IPTABLES_CHAIN" -i "$VPN_IF" -o "$_if" -d "$_subnet" -m state --state RELATED,ESTABLISHED -j ACCEPT

    if [ "$_if" = "$ROUTER_AP_IF" ] && [ -n "$ROUTER_AP_ALIAS_IP" ] && [ -n "$ROUTER_AP_ROUTER_IP" ]; then
        if ip -4 addr show eth0 2>/dev/null | grep -q "192.168.100\."; then
            ip -4 addr add "$ROUTER_AP_ALIAS_IP/24" dev eth0 label eth0:router 2>/dev/null || true
            iptables -C INPUT -p tcp --dport 8092 -j ACCEPT 2>/dev/null || \
                iptables -I INPUT 1 -p tcp --dport 8092 -j ACCEPT
            iptables -t nat -C PREROUTING -d "$ROUTER_AP_ALIAS_IP" -p tcp --dport 80 -j REDIRECT --to-ports 8092 2>/dev/null || \
                iptables -t nat -A PREROUTING -d "$ROUTER_AP_ALIAS_IP" -p tcp --dport 80 -j REDIRECT --to-ports 8092
            iptables -t nat -C OUTPUT -d "$ROUTER_AP_ALIAS_IP" -p tcp --dport 80 -j REDIRECT --to-ports 8092 2>/dev/null || \
                iptables -t nat -A OUTPUT -d "$ROUTER_AP_ALIAS_IP" -p tcp --dport 80 -j REDIRECT --to-ports 8092
            iptables -t nat -C PREROUTING -d "$ROUTER_AP_ALIAS_IP" ! -p tcp -j DNAT --to-destination "$ROUTER_AP_ROUTER_IP" 2>/dev/null || \
                iptables -t nat -A PREROUTING -d "$ROUTER_AP_ALIAS_IP" ! -p tcp -j DNAT --to-destination "$ROUTER_AP_ROUTER_IP"
            iptables -C "$IPTABLES_CHAIN" -d "$ROUTER_AP_ROUTER_IP" -j ACCEPT 2>/dev/null || \
                iptables -A "$IPTABLES_CHAIN" -d "$ROUTER_AP_ROUTER_IP" -j ACCEPT
        fi
    fi

    # Fail-closed Kill Switch: reject client traffic attempting to route without active VPN or matching bypass
    iptables -A "$IPTABLES_CHAIN" -i "$_if" -s "$_subnet" -j REJECT --reject-with icmp-net-prohibited

    iptables -t mangle -C FORWARD -s "$_subnet" -o "$VPN_IF" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null || \
        iptables -t mangle -A FORWARD -s "$_subnet" -o "$VPN_IF" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
    iptables -t mangle -C FORWARD -i "$VPN_IF" -d "$_subnet" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null || \
        iptables -t mangle -A FORWARD -i "$VPN_IF" -d "$_subnet" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu

    iptables -C INPUT -i "$_if" -p udp --dport 67:68 -j ACCEPT 2>/dev/null || \
        iptables -A INPUT -i "$_if" -p udp --dport 67:68 -j ACCEPT
    iptables -C INPUT -i "$_if" -p tcp --dport 53 -j ACCEPT 2>/dev/null || \
        iptables -A INPUT -i "$_if" -p tcp --dport 53 -j ACCEPT
    iptables -C INPUT -i "$_if" -p udp --dport 53 -j ACCEPT 2>/dev/null || \
        iptables -A INPUT -i "$_if" -p udp --dport 53 -j ACCEPT
    iptables -C INPUT -i "$_if" -p tcp --dport 22 -j ACCEPT 2>/dev/null || \
        iptables -A INPUT -i "$_if" -p tcp --dport 22 -j ACCEPT
    iptables -C INPUT -i "$_if" -p udp --dport 5353 -j ACCEPT 2>/dev/null || \
        iptables -A INPUT -i "$_if" -p udp --dport 5353 -j ACCEPT
    iptables -C INPUT -i "$_if" -p icmp -j ACCEPT 2>/dev/null || \
        iptables -A INPUT -i "$_if" -p icmp -j ACCEPT
    iptables -C INPUT -i "$_if" -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || \
        iptables -A INPUT -i "$_if" -m state --state RELATED,ESTABLISHED -j ACCEPT
    iptables -C INPUT -i "$_if" -s "$_subnet" -j REJECT --reject-with icmp-port-unreachable 2>/dev/null || \
        iptables -A INPUT -i "$_if" -s "$_subnet" -j REJECT --reject-with icmp-port-unreachable

    if [ -n "$_ip" ]; then
        iptables -t nat -C PREROUTING -i "$_if" -p udp --dport 53 ! -d "$_ip" -j DNAT --to-destination "$_ip:53" 2>/dev/null || \
            iptables -t nat -A PREROUTING -i "$_if" -p udp --dport 53 ! -d "$_ip" -j DNAT --to-destination "$_ip:53"
        iptables -t nat -C PREROUTING -i "$_if" -p tcp --dport 53 ! -d "$_ip" -j DNAT --to-destination "$_ip:53" 2>/dev/null || \
            iptables -t nat -A PREROUTING -i "$_if" -p tcp --dport 53 ! -d "$_ip" -j DNAT --to-destination "$_ip:53"
    fi

    iptables -C "$IPTABLES_CHAIN" -i "$_if" -p tcp --dport 853 -j REJECT 2>/dev/null || \
        iptables -I "$IPTABLES_CHAIN" 1 -i "$_if" -p tcp --dport 853 -j REJECT
    iptables -C "$IPTABLES_CHAIN" -i "$_if" -p udp --dport 853 -j REJECT 2>/dev/null || \
        iptables -I "$IPTABLES_CHAIN" 1 -i "$_if" -p udp --dport 853 -j REJECT

    for doh_ip in 8.8.8.8 8.8.4.4 1.1.1.1 1.0.0.1 9.9.9.9 149.112.112.112 208.67.222.222 208.67.220.220 94.140.14.14 94.140.15.15 76.76.2.0 76.76.10.0; do
        iptables -C "$IPTABLES_CHAIN" -i "$_if" -d "$doh_ip" -p tcp --dport 443 -j REJECT 2>/dev/null || \
            iptables -I "$IPTABLES_CHAIN" 1 -i "$_if" -d "$doh_ip" -p tcp --dport 443 -j REJECT
        iptables -C "$IPTABLES_CHAIN" -i "$_if" -d "$doh_ip" -p udp --dport 443 -j REJECT 2>/dev/null || \
            iptables -I "$IPTABLES_CHAIN" 1 -i "$_if" -d "$doh_ip" -p udp --dport 443 -j REJECT
    done

    ip6tables -C INPUT -i "$_if" -p udp --dport 53 -j REJECT 2>/dev/null || \
        ip6tables -A INPUT -i "$_if" -p udp --dport 53 -j REJECT
    ip6tables -C INPUT -i "$_if" -p tcp --dport 53 -j REJECT 2>/dev/null || \
        ip6tables -A INPUT -i "$_if" -p tcp --dport 53 -j REJECT

    case "$IPV6_LEAK_PROTECTION" in
        drop|1|true|yes)
            ensure_ip6_filter_chain "$IP6TABLES_CHAIN"
            ip6tables -A "$IP6TABLES_CHAIN" -i "$_if" -j DROP
            ;;
        reject)
            ensure_ip6_filter_chain "$IP6TABLES_CHAIN"
            ip6tables -A "$IP6TABLES_CHAIN" -i "$_if" -j REJECT --reject-with icmp6-adm-prohibited
            ;;
        off|0|false|no)
            ;;
        *)
            ensure_ip6_filter_chain "$IP6TABLES_CHAIN"
            ip6tables -A "$IP6TABLES_CHAIN" -i "$_if" -j DROP
            ;;
    esac

    if [ -w "/proc/sys/net/ipv4/conf/$_if/send_redirects" ]; then
        echo 0 > "/proc/sys/net/ipv4/conf/$_if/send_redirects" 2>/dev/null || true
    fi
}

detect_lan_gw() {
    if [ -n "$LAN_GW_OVERRIDE" ]; then
        printf '%s\n' "$LAN_GW_OVERRIDE"
        return
    fi

    ip -4 route show default dev "$LAN_IF" 2>/dev/null | awk '/ via / {print $3; exit}'
    nmcli -g IP4.GATEWAY device show "$LAN_IF" 2>/dev/null | awk 'NF {print; exit}'
    ip -4 route show dev "$LAN_IF" 2>/dev/null | awk '/ via / {print $3; exit}'
    ip -4 addr show dev "$LAN_IF" 2>/dev/null | awk '
        /inet / {
            split($2, addr, "/")
            split(addr[1], octet, ".")
            if (octet[1] && octet[2] && octet[3]) {
                print octet[1] "." octet[2] "." octet[3] ".1"
                exit
            }
        }
    '
}

apply_policy() {
    LAN_GW="$(detect_lan_gw | awk 'NF {print; exit}')"
    WAN_SUBNET="$(detect_wan_subnet "$LAN_IF")"
    if [ -n "$WAN_SUBNET" ]; then
        case " $MANAGEMENT_SUBNETS " in
            *" $WAN_SUBNET "*) ;;
            *) MANAGEMENT_SUBNETS="$MANAGEMENT_SUBNETS $WAN_SUBNET" ;;
        esac
    fi

    # Purge any WireGuard / AmneziaWG auto-routing rules that conflict with policy routing
    while ip -4 rule show 2>/dev/null | grep -q "lookup 51820"; do
        ip -4 rule del table 51820 2>/dev/null || break
    done
    while ip -4 rule show 2>/dev/null | grep -q "from all lookup main suppress_prefixlength 0"; do
        ip -4 rule del table main suppress_prefixlength 0 2>/dev/null || break
    done
    ip -4 route flush table 51820 2>/dev/null || true

    echo 1 > /proc/sys/net/ipv4/ip_forward
    if [ -w /proc/sys/net/ipv4/conf/all/send_redirects ]; then
        echo 0 > /proc/sys/net/ipv4/conf/all/send_redirects 2>/dev/null || true
    fi
    if [ -w /proc/sys/net/ipv4/conf/default/send_redirects ]; then
        echo 0 > /proc/sys/net/ipv4/conf/default/send_redirects 2>/dev/null || true
    fi

    if ip link show "$VPN_IF" >/dev/null 2>&1; then
        if ! ip link set dev "$VPN_IF" mtu "$VPN_MTU"; then
            echo "Could not set $VPN_IF MTU to $VPN_MTU" >&2
            return 1
        fi
    fi
    ipset create "$VPN_IPSET" hash:ip 2>/dev/null || true
    ipset create "$VPN_ROUTES_IPSET" hash:net family inet 2>/dev/null || true
    ipset create "$LOCAL_ROUTES_IPSET" hash:net family inet 2>/dev/null || true
    if [ "$VPN_ROUTES_IPSET" != "$LEGACY_GITHUB_IPSET" ]; then
        remove_rule mangle OUTPUT -m set --match-set "$LEGACY_GITHUB_IPSET" dst -j MARK --set-mark "$FWMARK"
        ipset destroy "$LEGACY_GITHUB_IPSET" 2>/dev/null || true
    fi
    if [ "$LOCAL_ROUTES_IPSET" != "$LEGACY_LOCAL_IPSET" ]; then
        for wan in "$LAN_IF" eth0 usb0 eth1 usb1; do
            remove_rule nat POSTROUTING -s "$HOTSPOT_SUBNET" -m set --match-set "$LEGACY_LOCAL_IPSET" dst -o "$wan" -j MASQUERADE
            remove_rule "$IPTABLES_CHAIN" -i "$HOTSPOT_IF" -o "$wan" -s "$HOTSPOT_SUBNET" -m set --match-set "$LEGACY_LOCAL_IPSET" dst -j ACCEPT
            if [ -n "$ROUTER_AP_IF" ] && [ -n "$ROUTER_AP_SUBNET" ]; then
                remove_rule nat POSTROUTING -s "$ROUTER_AP_SUBNET" -m set --match-set "$LEGACY_LOCAL_IPSET" dst -o "$wan" -j MASQUERADE
                remove_rule "$IPTABLES_CHAIN" -i "$ROUTER_AP_IF" -o "$wan" -s "$ROUTER_AP_SUBNET" -m set --match-set "$LEGACY_LOCAL_IPSET" dst -j ACCEPT
            fi
        done
        remove_rule mangle PREROUTING -s "$HOTSPOT_SUBNET" -m set --match-set "$LEGACY_LOCAL_IPSET" dst -j MARK --set-mark "$BYPASS_FWMARK"
        remove_rule mangle PREROUTING -s "$HOTSPOT_SUBNET" -m set --match-set "$LEGACY_LOCAL_IPSET" dst -j MARK --set-mark 0
        if [ -n "$ROUTER_AP_SUBNET" ]; then
            remove_rule mangle PREROUTING -s "$ROUTER_AP_SUBNET" -m set --match-set "$LEGACY_LOCAL_IPSET" dst -j MARK --set-mark "$BYPASS_FWMARK"
            remove_rule mangle PREROUTING -s "$ROUTER_AP_SUBNET" -m set --match-set "$LEGACY_LOCAL_IPSET" dst -j MARK --set-mark 0
        fi
        ipset destroy "$LEGACY_LOCAL_IPSET" 2>/dev/null || true
    fi

    # Clean old rules before reapplying
    remove_ap_rules "$HOTSPOT_IF" "$HOTSPOT_SUBNET" "$HOTSPOT_IP"
    if [ -n "$ROUTER_AP_IF" ] && [ -n "$ROUTER_AP_SUBNET" ]; then
        remove_ap_rules "$ROUTER_AP_IF" "$ROUTER_AP_SUBNET" "$ROUTER_AP_IP"
    fi
    remove_ap_rules "eth1" "192.168.0.0/24" ""

    ensure_filter_chain "$IPTABLES_CHAIN"

    remove_rule mangle PREROUTING -m set --match-set "$VPN_IPSET" dst -j MARK --set-mark "$FWMARK"
    remove_rule mangle PREROUTING -m set --match-set "$VPN_ROUTES_IPSET" dst -j MARK --set-mark "$FWMARK"
    remove_rule mangle OUTPUT -m set --match-set "$VPN_IPSET" dst -j MARK --set-mark "$FWMARK"
    remove_rule mangle OUTPUT -m set --match-set "$VPN_ROUTES_IPSET" dst -j MARK --set-mark "$FWMARK"
    for dns_ip in 8.8.8.8 8.8.4.4 1.1.1.1 1.0.0.1 9.9.9.9 149.112.112.112 208.67.222.222 208.67.220.220; do
        remove_rule mangle OUTPUT -d "$dns_ip" -p udp --dport 53 -j MARK --set-mark "$FWMARK"
        remove_rule mangle OUTPUT -d "$dns_ip" -p tcp --dport 53 -j MARK --set-mark "$FWMARK"
    done
    remove_rule mangle OUTPUT -o "$VPN_IF" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --set-mss 1200
    remove_rule mangle POSTROUTING -o "$VPN_IF" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
    remove_rule nat POSTROUTING -o "$VPN_IF" -j MASQUERADE

    ip route del default dev "$VPN_IF" table main metric 100 2>/dev/null || \
        ip route del default dev "$VPN_IF" table main 2>/dev/null || true
    if [ -n "$LAN_GW" ]; then
        ip route add default via "$LAN_GW" dev "$LAN_IF" metric 100 2>/dev/null || \
            ip route replace default via "$LAN_GW" dev "$LAN_IF" metric 100 2>/dev/null || true
    fi

    route_installed=0
    for _ in 1 2 3 4 5; do
        if ip route replace default dev "$VPN_IF" table "$TABLE_ID" 2>/dev/null; then
            route_installed=1
            break
        fi
        sleep 0.2
    done
    if [ "$route_installed" -eq 0 ]; then
        ip route replace default dev "$VPN_IF" table "$TABLE_ID" 2>/dev/null || true
    fi
    ip route replace unreachable default table "$TABLE_ID" metric 1024 2>/dev/null || true

    ip rule del fwmark "$FWMARK" table "$TABLE_ID" priority "$HOST_RULE_PRIORITY" 2>/dev/null || true
    ip rule add fwmark "$FWMARK" table "$TABLE_ID" priority "$HOST_RULE_PRIORITY" 2>/dev/null || true
    ip rule del fwmark "$BYPASS_FWMARK" table main priority "$BYPASS_RULE_PRIORITY" 2>/dev/null || true
    ip rule add fwmark "$BYPASS_FWMARK" table main priority "$BYPASS_RULE_PRIORITY" 2>/dev/null || true

    iptables -t nat -C POSTROUTING -o "$VPN_IF" -j MASQUERADE 2>/dev/null || \
        iptables -t nat -A POSTROUTING -o "$VPN_IF" -j MASQUERADE

    # Apply AP rules for Hotspot interface
    apply_ap_rules "$HOTSPOT_IF" "$HOTSPOT_SUBNET" "$HOTSPOT_IP"

    # Apply AP rules for Secondary Router AP interface
    if [ -n "$ROUTER_AP_IF" ] && [ -n "$ROUTER_AP_SUBNET" ]; then
        apply_ap_rules "$ROUTER_AP_IF" "$ROUTER_AP_SUBNET" "$ROUTER_AP_IP"

        # Inter-hotspot communication between HOTSPOT_SUBNET and ROUTER_AP_SUBNET
        ip rule del from "$HOTSPOT_SUBNET" to "$ROUTER_AP_SUBNET" table main priority "$MANAGEMENT_RULE_PRIORITY" 2>/dev/null || true
        ip rule add from "$HOTSPOT_SUBNET" to "$ROUTER_AP_SUBNET" table main priority "$MANAGEMENT_RULE_PRIORITY" 2>/dev/null || true
        ip rule del from "$ROUTER_AP_SUBNET" to "$HOTSPOT_SUBNET" table main priority "$MANAGEMENT_RULE_PRIORITY" 2>/dev/null || true
        ip rule add from "$ROUTER_AP_SUBNET" to "$HOTSPOT_SUBNET" table main priority "$MANAGEMENT_RULE_PRIORITY" 2>/dev/null || true

        iptables -I "$IPTABLES_CHAIN" 1 -i "$HOTSPOT_IF" -o "$ROUTER_AP_IF" -s "$HOTSPOT_SUBNET" -d "$ROUTER_AP_SUBNET" -j ACCEPT
        iptables -I "$IPTABLES_CHAIN" 1 -i "$ROUTER_AP_IF" -o "$HOTSPOT_IF" -s "$ROUTER_AP_SUBNET" -d "$HOTSPOT_SUBNET" -j ACCEPT
    fi

    # Host-level DNS markings and MSS clamping
    iptables -t mangle -C PREROUTING -m set --match-set "$VPN_IPSET" dst -j MARK --set-mark "$FWMARK" 2>/dev/null || \
        iptables -t mangle -A PREROUTING -m set --match-set "$VPN_IPSET" dst -j MARK --set-mark "$FWMARK"
    iptables -t mangle -C PREROUTING -m set --match-set "$VPN_ROUTES_IPSET" dst -j MARK --set-mark "$FWMARK" 2>/dev/null || \
        iptables -t mangle -A PREROUTING -m set --match-set "$VPN_ROUTES_IPSET" dst -j MARK --set-mark "$FWMARK"
    iptables -t mangle -C OUTPUT -m set --match-set "$VPN_IPSET" dst -j MARK --set-mark "$FWMARK" 2>/dev/null || \
        iptables -t mangle -A OUTPUT -m set --match-set "$VPN_IPSET" dst -j MARK --set-mark "$FWMARK"
    iptables -t mangle -C OUTPUT -m set --match-set "$VPN_ROUTES_IPSET" dst -j MARK --set-mark "$FWMARK" 2>/dev/null || \
        iptables -t mangle -A OUTPUT -m set --match-set "$VPN_ROUTES_IPSET" dst -j MARK --set-mark "$FWMARK"
    for dns_ip in 8.8.8.8 8.8.4.4 1.1.1.1 1.0.0.1 9.9.9.9 149.112.112.112 208.67.222.222 208.67.220.220; do
        iptables -t mangle -C OUTPUT -d "$dns_ip" -p udp --dport 53 -j MARK --set-mark "$FWMARK" 2>/dev/null || \
            iptables -t mangle -A OUTPUT -d "$dns_ip" -p udp --dport 53 -j MARK --set-mark "$FWMARK"
        iptables -t mangle -C OUTPUT -d "$dns_ip" -p tcp --dport 53 -j MARK --set-mark "$FWMARK" 2>/dev/null || \
            iptables -t mangle -A OUTPUT -d "$dns_ip" -p tcp --dport 53 -j MARK --set-mark "$FWMARK"
    done
    iptables -t mangle -C OUTPUT -o "$VPN_IF" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --set-mss 1200 2>/dev/null || \
        iptables -t mangle -A OUTPUT -o "$VPN_IF" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --set-mss 1200
    iptables -t mangle -C POSTROUTING -o "$VPN_IF" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null || \
        iptables -t mangle -A POSTROUTING -o "$VPN_IF" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
}

cleanup_policy() {
    WAN_SUBNET="$(detect_wan_subnet "$LAN_IF")"
    if [ -n "$WAN_SUBNET" ]; then
        case " $MANAGEMENT_SUBNETS " in
            *" $WAN_SUBNET "*) ;;
            *) MANAGEMENT_SUBNETS="$MANAGEMENT_SUBNETS $WAN_SUBNET" ;;
        esac
    fi

    remove_rule nat POSTROUTING -o "$VPN_IF" -j MASQUERADE

    remove_ap_rules "$HOTSPOT_IF" "$HOTSPOT_SUBNET" "$HOTSPOT_IP"
    if [ -n "$ROUTER_AP_IF" ] && [ -n "$ROUTER_AP_SUBNET" ]; then
        remove_ap_rules "$ROUTER_AP_IF" "$ROUTER_AP_SUBNET" "$ROUTER_AP_IP"
        ip rule del from "$HOTSPOT_SUBNET" to "$ROUTER_AP_SUBNET" table main priority "$MANAGEMENT_RULE_PRIORITY" 2>/dev/null || true
        ip rule del from "$ROUTER_AP_SUBNET" to "$HOTSPOT_SUBNET" table main priority "$MANAGEMENT_RULE_PRIORITY" 2>/dev/null || true
    fi
    remove_ap_rules "eth1" "192.168.0.0/24" ""

    remove_rule mangle PREROUTING -m set --match-set "$VPN_IPSET" dst -j MARK --set-mark "$FWMARK"
    remove_rule mangle PREROUTING -m set --match-set "$VPN_ROUTES_IPSET" dst -j MARK --set-mark "$FWMARK"
    remove_rule mangle OUTPUT -m set --match-set "$VPN_IPSET" dst -j MARK --set-mark "$FWMARK"
    remove_rule mangle OUTPUT -m set --match-set "$VPN_ROUTES_IPSET" dst -j MARK --set-mark "$FWMARK"
    remove_rule mangle OUTPUT -m set --match-set "$LEGACY_GITHUB_IPSET" dst -j MARK --set-mark "$FWMARK"
    for dns_ip in 8.8.8.8 8.8.4.4 1.1.1.1 1.0.0.1 9.9.9.9 149.112.112.112 208.67.222.222 208.67.220.220; do
        remove_rule mangle OUTPUT -d "$dns_ip" -p udp --dport 53 -j MARK --set-mark "$FWMARK"
        remove_rule mangle OUTPUT -d "$dns_ip" -p tcp --dport 53 -j MARK --set-mark "$FWMARK"
    done
    remove_rule mangle OUTPUT -o "$VPN_IF" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --set-mss 1200
    remove_rule mangle POSTROUTING -o "$VPN_IF" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu

    remove_filter_chain "$IPTABLES_CHAIN"
    remove_ip6_filter_chain "$IP6TABLES_CHAIN"

    ip rule del fwmark "$FWMARK" table "$TABLE_ID" priority "$HOST_RULE_PRIORITY" 2>/dev/null || true
    ip rule del fwmark "$BYPASS_FWMARK" table main priority "$BYPASS_RULE_PRIORITY" 2>/dev/null || true
    ip route flush table "$TABLE_ID" 2>/dev/null || true
}

case "$ACTION" in
    apply)
        apply_policy
        ;;
    cleanup)
        cleanup_policy
        ;;
    down|vpn-down)
        if [ "$VPN_BACKEND" != "auto" ] && [ "$VPN_BACKEND" != "$1" ]; then
            if ip link show "$VPN_BACKEND" >/dev/null 2>&1; then
                VPN_IF="$VPN_BACKEND"
                apply_policy
                exit 0
            fi
        fi
        if [ "$VPN_BACKEND" = "auto" ]; then
            other_if=""
            for cand in sing0 awg0 wg0 tun0; do
                if [ "$cand" != "$1" ] && ip -4 addr show "$cand" 2>/dev/null | grep -q "inet "; then
                    other_if="$cand"
                    break
                fi
            done
            if [ -n "$other_if" ]; then
                VPN_IF="$other_if"
                apply_policy
                exit 0
            fi
        fi
        cleanup_policy
        ;;
    up|vpn-up|connectivity-change)
        if ip link show "$VPN_IF" >/dev/null 2>&1; then
            apply_policy
        fi
        ;;
esac
